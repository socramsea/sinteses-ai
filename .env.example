# ============================================================
# Síntese — variáveis de ambiente (TODAS server-side)
# Copie para .env e preencha. NUNCA commitar o .env real.
# ============================================================

# --- Infra ---
REDIS_URL=redis://redis:6379/0
ENV=production
LOG_LEVEL=INFO

# --- Anthropic (pesquisa + roteiro) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Caching de prompt: ligado por padrão nos prefixos estáticos (research_system).
ANTHROPIC_ENABLE_PROMPT_CACHE=true

# --- fal.ai (geração de vídeo) ---
FAL_KEY=
# Slug NÃO se chumba. Puxe o id exato da galeria do fal.
FAL_MODEL_I2V=fal-ai/kling-video/v2/pro/image-to-video
FAL_MODEL_T2V=fal-ai/veo3/fast

# --- DigitalOcean Spaces (storage de mídia) ---
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=nyc3
SPACES_BUCKET=sintese-media
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# --- Controle de custo (requisito, não detalhe) ---
JOB_BUDGET_BRL_MAX=200          # teto por job em R$
JOB_MAX_RETRIES=2
JOB_MAX_SCENES=12               # corta runaway de cenas
PROVIDER_POLL_INTERVAL_S=8
PROVIDER_POLL_TIMEOUT_S=900

# --- Compliance (inegociável) ---
AI_DISCLOSURE_LABEL=Cenas recriadas por IA · imagens ilustrativas
REQUIRE_SOURCES=true            # bloqueia render sem fonte citada
ALLOW_PHOTOREAL_REAL_EVENT=false  # proíbe IA passar-se por filmagem real
